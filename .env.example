# Copy to .env (gitignored) and uncomment the keys you actually need. Spring loads .env
# through spring.config.import: optional:file:.env[.properties], so key names here map
# directly onto the ${...} placeholders in application.yml.
#
# Every key is written commented-out on purpose: a `.properties` file with `KEY=` defines
# the key as an empty string, which would override application.yml's defaults with a blank
# value rather than falling through to them.
#
# Never commit real credentials. Rotate anything pasted into a chat, ticket, or PR.

# ---- Local MySQL (these already exist in the working .env) -------------------------
# username=root
# password=change-me
# PORT=3001
# redis_port=6379

# ---- Database target ---------------------------------------------------------------
# Unset DB_URL/DB_DRIVER/FLYWAY_LOCATIONS == the historical local MySQL setup.
#
# MySQL:
# DB_URL=jdbc:mysql://localhost:3306/nexuscommerce?useSSL=false
# DB_USER=root
# DB_PASSWORD=change-me
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# FLYWAY_LOCATIONS=classpath:db/migration
#
# PostgreSQL / Supabase -- use the Supavisor session pooler (IPv4); the direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from many networks. Keep the
# <user>.<project-ref> username form and pass the schema through currentSchema. The JDBC
# timeouts stop a pooler-closed session from blocking a long migration forever, and
# DB_MIN_IDLE=1 keeps the pool from parking idle sessions a pooler will reap.
# DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=nexuscommercedb&connectTimeout=15&socketTimeout=120&tcpKeepAlive=true
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=change-me
# DB_DRIVER=org.postgresql.Driver
# FLYWAY_LOCATIONS=classpath:db/migration-postgres
# DB_POOL_SIZE=10
# DB_MIN_IDLE=1

# ---- Auth --------------------------------------------------------------------------
# JWT_SECRET=at-least-32-bytes-of-random-value

# ---- Local Flyway repair (development only) ----------------------------------------
# Repairs a half-applied local schema history before migrating. Off by default; the prod
# profile forces it off so a failed migration stops the boot instead of being patched over.
# FLYWAY_REPAIR=true

# ---- ADMIN bootstrap (dev/test only) -----------------------------------------------
# Both keys must be set or the runner stays inert. It creates the account if missing, or
# promotes it and resets its password if it already exists, on every boot — so the admin
# surface (products, variants, categories, order delete, dashboard) can be exercised without
# hand-editing rows. NEVER set these in a deployment that real shoppers can reach.
# ADMIN_BOOTSTRAP_EMAIL=admin@nexuscommerce.test
# ADMIN_BOOTSTRAP_PASSWORD=change-me-local-only
# ADMIN_BOOTSTRAP_NAME=Platform Admin

# ---- Managed Redis (Upstash / Aiven) -----------------------------------------------
# Leave unset for the local Homebrew Redis. Upstash hands out one URL; keep the ":6379"
# port, which their console sometimes omits — Boot cannot infer it and fails to start.
# Credentials and TLS belong in the URL (rediss://default:change-me@host:6379).
# REDIS_URL=rediss://default:change-me@your-instance.upstash.io:6379
#
# Without REDIS_URL the app composes redis://${REDIS_HOST}:${REDIS_PORT} from the two
# values below, which is why a plain local server needs no URL at all.
# REDIS_HOST=localhost
# REDIS_PORT=6379
#
# Neither URL nor the parts need a trailing slash. Lettuce's command timeout also covers
# the TLS handshake, so a managed Redis on another continent needs a few seconds.
# REDIS_TIMEOUT=3s
# REDIS_CONNECT_TIMEOUT=5s

# ---- Object storage / limits -------------------------------------------------------
# STORAGE_TYPE=local (default) keeps images under UPLOAD_DIR; s3 uses any S3-compatible
# store. With s3, every S3_* value below except the prefix is required at startup.
# UPLOAD_DIR=uploads/products
#
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-northeast-1
# S3_BUCKET=nexus-commerce
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/nexus-commerce
# S3_KEY_PREFIX=products

# ---- CORS --------------------------------------------------------------------------
# Comma-separated browser origins. Include the API's own origin for Swagger UI.
# CORS_ALLOWED_ORIGINS=https://plain-thread.vercel.app,https://nexus-commerce-api.onrender.com

# ---- Razorpay ----------------------------------------------------------------------
# Test keys (rzp_test_...) unless the account has completed KYC for live mode.
# RAZORPAY_KEY_ID=rzp_test_change-me
# RAZORPAY_KEY_SECRET=change-me
# RAZORPAY_WEBHOOK_SECRET=change-me
